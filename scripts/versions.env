# Pinned versions: the setup the published result was measured on (2026-09-29). Sourced by every script.
# Change a value here, not in the scripts; scripts/check-versions.sh lists newer upstream releases.
# The result holds for THESE pins. A newer version is a separate measurement, not a replacement.
# At run time scripts/platform.sh writes lab/.runtime/pins.env from this file; checks/01-pins.sh enforces it.

# Tools, downloaded into bin/ by scripts/platform.sh install (sha256-checked, only when missing)
TOFU_VERSION="1.12.6"
FLUX_VERSION="2.9.5"
K3D_VERSION="v5.8.3"
KUBECTL_VERSION="v1.35.0"

# Cluster image (k3d runs k3s as a container) and the kubernetes provider; the provider must equal tofu/versions.tf
K3S_IMAGE="rancher/k3s:v1.37.0-k3s1"
K8S_PROVIDER_VERSION="2.38.0"

# The lab's k3d cluster and local registry. Scripts create and delete only these names.
CLUSTER="t27"
REGISTRY="t27-reg"
REGISTRY_PORT="5111"

# The experiment object and namespaces
NS="t27"
CM="t27"
STATE_NS="t27-state"
STATE_SECRET="tfstate-default-t27"
KS="t27"
